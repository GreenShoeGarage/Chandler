{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chandler.local/schemas/proposal.schema.json",
  "title": "CHANDLER Community Proposal",
  "type": "object",
  "required": ["schemaVersion", "type", "proposedChange", "createdAt", "state"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 3 },
    "type": { "enum": ["New family", "New variant", "New supplier reference", "Correction", "New alias", "New interface", "Compatibility claim", "Deprecation recommendation", "Broken-link report", "Safety concern", "Additional project evidence"] },
    "proposedChange": { "type": "string", "minLength": 1 }, "supportingSource": { "type": "string" }, "originalWording": { "type": "string" }, "dimensions": { "type": "array" }, "useCase": { "type": "string" }, "limitations": { "type": "string" }, "alternatives": { "type": "array" }, "submitterNotes": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" }, "state": { "const": "Proposed" }
  }
}
