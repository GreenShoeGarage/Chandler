{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chandler.local/schemas/observation.schema.json",
  "title": "CHANDLER Raw Observation",
  "type": "object",
  "required": ["observationId", "sourceId", "sourceProjectId", "sourceProjectFamilyId", "projectCategory", "originalDescription", "originalQuantity", "originalUnit", "sourceUrl", "sourceLicense", "observedAt", "parserVersion", "contentHash", "ingestionRunId"],
  "properties": {
    "observationId": { "type": "string", "pattern": "^OBS-[0-9]{8}$" }, "sourceId": { "type": "string" }, "sourceProjectId": { "type": "string" }, "sourceProjectFamilyId": { "type": "string" }, "projectCategory": { "type": "string" }, "originalDescription": { "type": "string", "minLength": 1 }, "originalQuantity": { "type": ["number", "null"], "minimum": 0 }, "originalUnit": { "type": ["string", "null"] }, "sourceUrl": { "type": "string" }, "sourceLicense": { "type": "string" }, "observedAt": { "type": "string", "format": "date" }, "parserVersion": { "type": "string" }, "contentHash": { "type": "string" }, "ingestionRunId": { "type": "string" }
  }, "additionalProperties": true
}
