{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chandler.local/schemas/project.schema.json",
  "title": "CHANDLER Project BOM",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "lines", "baselines"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 3 },
    "id": { "type": "string" }, "name": { "type": "string", "minLength": 1 },
    "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } },
    "baselines": { "type": "array", "items": { "type": "object", "required": ["id", "createdAt", "catalogVersion", "lines"] } }
  },
  "$defs": { "line": { "type": "object", "required": ["id", "quantity", "unit", "intent", "selectedRevision"], "properties": { "id": { "type": "string" }, "quantity": { "type": "number", "minimum": 0 }, "unit": { "type": "string" }, "intent": { "enum": ["Required", "Preferred", "Optional", "Substitute"] }, "referenceDesignators": { "type": "array", "items": { "type": "string" } }, "assemblyLocation": { "type": "string" }, "note": { "type": "string" }, "alternatives": { "type": "array" }, "selectedRevision": { "type": "object", "required": ["catalogVersion", "recordId", "recordRevision", "snapshot"] } } } }
}
